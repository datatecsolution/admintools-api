# =====================================================================
# Stack de pruebas dulce — credenciales. Copiar a .env (chmod 600).
# NUNCA commitear .env. Compose interpola ${VARS} del yml desde este archivo.
# =====================================================================

# Spring escucha en 8080 dentro del container (mapping 8084:8080).
SERVER_PORT=8080

# Root del MySQL del stack (solo vive en el contenedor de pruebas).
PRUEBAS_MYSQL_ROOT_PASSWORD=CAMBIAR

# Usuario que usa la API (debe coincidir con mysql-init/02-usuario-api.sql).
MYSQL_USER=apipruebas
MYSQL_PASSWORD=CAMBIAR_EN_EL_SERVER
MYSQL_DB=admin_tools
MYSQL_TZ=GMT-6

# JWT: usar un secreto propio del stack de pruebas (ver más abajo). NO tomar
# el de producción — el default histórico es público en el repo (US-049).

# CORS: desde dónde se abre el POS de pruebas en el navegador.
CORS_ALLOWED_ORIGINS=http://10.10.0.1:8090

# URL de la API que se hornea en el bundle del POS (build-arg).
# Debe ser alcanzable desde el NAVEGADOR del tester.
POS_API_URL=http://10.10.0.1:8084/admin_tools/api

# JWT del stack de pruebas (cualquier secreto largo; los testers loguean de cero).
APP_JWT_SECRET=CAMBIAR_openssl_rand_base64_48
