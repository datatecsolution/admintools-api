# =====================================================================
# admin-tools-api-v2 — Variables de entorno productivas
#
# COPIAR a .env-admintools y editar con los valores reales del cliente.
#   cp .env-admintools.example .env-admintools
#   chmod 600 .env-admintools
#   # editar con vim/nano
#
# NUNCA commitear .env-admintools (sin .example) — esta en .gitignore.
# =====================================================================

# ----- MySQL -----------------------------------------------------------
# host.docker.internal resuelve al host del server Linux gracias a
# extra_hosts: host-gateway en el docker-compose. MySQL del cliente
# corre en el host (no en docker), por eso esta config.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DB=admin_tools
MYSQL_USER=admin
MYSQL_PASSWORD=REEMPLAZAR_CON_PASSWORD_REAL
MYSQL_TZ=GMT-6

# ----- JWT -------------------------------------------------------------
# Generar uno NUEVO con: openssl rand -base64 48
# OJO: si cambias el secret, los tokens actuales se invalidan y todos
# los usuarios deberan volver a loguearse. Si querés mantener sesiones,
# pegá el secret historico (que se usaba en perfil dev) aqui temporalmente
# y lo rotas en otra ventana.
APP_JWT_SECRET=REEMPLAZAR_CON_openssl_rand_base64_48
APP_JWT_EXPIRATION_MS=518400000

# ----- CORS ------------------------------------------------------------
# Lista separada por comas. SIN slash al final. CON esquema (http/https).
# Agregar TODOS los origenes que consumen este API:
#   - App pedidos React actual
#   - Nueva app React (cuando este lista)
#   - localhost si haces dev pegando a este API
CORS_ALLOWED_ORIGINS=https://pos.cliente.example,https://pedidos.cliente.example,http://localhost:5173

# ----- Timezone --------------------------------------------------------
# Usado por la API en filtros de fecha (ej. /orders/today) y por el JVM
# para LocalDateTime.now() en @PrePersist.
APP_TIMEZONE=America/Tegucigalpa
TZ=America/Tegucigalpa
