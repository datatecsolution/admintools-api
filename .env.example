# Variables de entorno requeridas en produccion (perfil pdn).
# En dev (perfil activo = dev) cada una tiene un default en
# application-dev.properties; en prod NO hay defaults, faltarlas hace
# fallar el arranque (intencional).
#
# Uso con docker-compose:
#   cp .env.example .env
#   # editar .env con valores reales del cliente
#   docker compose --env-file .env up -d

# Perfil de Spring (dev | pdn).
SPRING_PROFILES_ACTIVE=pdn

# Server
SERVER_PORT=8080

# MySQL — un container por cliente, cada uno con su BD propia.
MYSQL_HOST=db.cliente.example
MYSQL_PORT=3306
MYSQL_DB=admin_tools
MYSQL_USER=admin_tools
MYSQL_PASSWORD=cambiar_en_produccion
MYSQL_TZ=GMT-6

# JWT — generar con: openssl rand -base64 48
APP_JWT_SECRET=cambiar_por_un_secret_aleatorio_de_al_menos_32_bytes
APP_JWT_EXPIRATION_MS=518400000

# CORS — lista separada por comas, sin slash al final, con esquema https/http.
CORS_ALLOWED_ORIGINS=https://pos.cliente.example,https://pedidos.cliente.example
